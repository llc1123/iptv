#!/bin/sh
# Prints the most recent system-log lines for the service, newest last.
#
# Usage: iptv-log [lines]

lines="${1:-300}"
case "$lines" in
	'' | *[!0-9]*) lines=300 ;;
esac
[ "$lines" -gt 2000 ] && lines=2000

# Server output carries the iptv_media_server target; the init script and
# procd log under the iptv-media-server tag.
logread -e 'iptv[-_]media[-_]server' 2>/dev/null | tail -n "$lines"
