[Unit]
Description=IPTV media server (eventual Rust primary)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/iptv
ExecStart=/usr/bin/env /opt/iptv/rust/target/release/iptv-media-server --interface eth1 --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=10s
LimitNOFILE=65536
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
