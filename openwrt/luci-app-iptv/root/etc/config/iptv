config server 'main'
	option enabled '1'
	option managed '0'
	option interface 'eth1'
	option host '0.0.0.0'
	option port '8080'
	option route_table '4788'
	option dhcp_user ''
	option dhcp_password ''
	option epg_user ''
	option epg_password ''
	option epg_mac ''
	option stb_id_prefix ''
	option authentication_url ''
	option guide_past_days '7'
	option guide_future_days '2'
	option guide_timezone 'Asia/Shanghai'
	option guide_cache '/var/lib/iptv/guide.json'
	option logo_dir '/etc/iptv/logos'
	option refresh_interval_seconds '3600'
