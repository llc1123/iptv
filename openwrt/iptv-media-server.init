#!/bin/sh /etc/rc.common
# procd service for OpenWrt. Install as /etc/init.d/iptv-media-server with the
# binary at /usr/bin/iptv-media-server and credentials in /etc/iptv.env
# (mode 600, IPTV_* variables as listed in the README). procd respawns the
# server, which is what replaces systemd's Restart=on-failure when a DHCP lease
# expires or the server hands out a different address.

USE_PROCD=1
START=95
STOP=10

start_service() {
	procd_open_instance
	# The leading dot sources /etc/iptv.env without exposing it on a cmdline.
	procd_set_param command /bin/sh -c 'set -a; . /etc/iptv.env; set +a; exec /usr/bin/iptv-media-server --host 0.0.0.0 --port 8080'
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger iptv
}
