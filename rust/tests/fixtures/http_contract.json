{
  "version": 1,
  "routes": [
    {"method": "GET", "path": "/healthz", "head": true},
    {"method": "GET", "path": "/channels.m3u", "head": true},
    {"method": "GET", "path": "/xmltv.xml", "head": true},
    {"method": "GET", "path": "/logos/{channel_id}", "head": true},
    {"method": "GET", "path": "/stream/{channel_id}", "head": true},
    {"method": "GET", "path": "/replay/{channel_id}/{programme_id}", "head": true},
    {"method": "GET", "path": "/catchup/{channel_id}", "head": true},
    {"method": "GET", "path": "/_hls/{*rest}", "head": true}
  ],
  "deferred": [
    "/metadata/sync",
    "/heartbeat",
    "/report"
  ],
  "errors": {
    "feed": 503,
    "logo": 503,
    "playback": 503,
    "hls": 502,
    "unknown_path": 404,
    "wrong_method": 405
  }
}
